# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Data — never commit case data or dumps
data/raw/*
data/processed/*
data/inbox/*
data/geoip/*
!data/**/.gitkeep
*.mmdb
*.csv
*.jsonl
*.parquet
*.db
*.sqlite3

# The offline bundle — built by offline/build_wheelhouse.sh, never committed.
# The wheelhouse alone is ~350 MB, and the intel snapshot is a copy of
# data/intel/, which is ignored above for the same reason.
offline/wheelhouse/
offline/intel/
offline/bundle.json

# Models
models/
*.joblib
*.pt
*.pkl

